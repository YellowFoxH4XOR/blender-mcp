{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-mcp.local/schemas/apply_scene_transaction.request.schema.json",
  "title": "Blender MCP apply_scene_transaction request",
  "allOf": [
    {"$ref": "common-request.schema.json"},
    {
      "type": "object",
      "properties": {
        "command": {"const": "apply_scene_transaction"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scene_path",
            "output_path",
            "transaction_id",
            "expected_source_sha256",
            "operations"
          ],
          "properties": {
            "scene_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/.+\\.blend$"
            },
            "output_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/.+\\.blend$"
            },
            "transaction_id": {
              "type": "string",
              "pattern": "^txn_[A-Za-z0-9_-]{1,116}$"
            },
            "expected_source_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "operations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "required": ["op"],
                "properties": {
                  "op": {
                    "enum": [
                      "set_transform",
                      "set_visibility",
                      "configure_scene",
                      "apply_action"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
